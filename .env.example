# PostgreSQL connection string. Required.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret required for all /api/admin/* routes (X-Admin-Secret header).
# Generate with: openssl rand -hex 32
ADMIN_SECRET=

# Public market-data API bases. Defaults shown; override only if needed.
OKX_API_BASE=https://www.okx.com
BINANCE_API_BASE=https://api.binance.com

# debug | info | warn | error
LOG_LEVEL=info

# If "1", a background loop advances paper-trading positions on a timer.
# Leave "0" on serverless platforms (Vercel) — use a cron hitting
# /api/admin/run-backtest-style endpoints instead. Safe to enable "1" on
# a single long-running instance (Railway).
ENABLE_BACKGROUND_JOBS=0
JOB_INTERVAL_MS=60000
